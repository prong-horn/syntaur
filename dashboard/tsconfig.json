{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/view-prefs-schema": ["../src/utils/view-prefs-schema.ts"],
      "@shared/usage-filters": ["../src/utils/usage-filters.ts"],
      "@shared/session-select": ["../src/utils/session-select.ts"],
      "@shared/session-sort": ["../src/utils/session-sort.ts"],
      "@shared/session-attribution": ["../src/utils/session-attribution.ts"],
      "@shared/session-archived": ["../src/utils/session-archived.ts"],
      "@shared/agents-schema": ["../src/utils/agents-schema.ts"],
      "@shared/terminal-schema": ["../src/utils/terminal-schema.ts"],
      "@shared/search-schema": ["../src/utils/search-schema.ts"],
      "@shared/branch-name": ["../src/utils/branch-name.ts"],
      "@shared/view-filters-query": ["../src/utils/view-filters-query.ts"],
      "@shared/query": ["../src/utils/query/index.ts"],
      "@shared/query-registry": ["../src/utils/query/registry.ts"]
    }
  },
  "include": [
    "src",
    "../src/utils/view-prefs-schema.ts",
    "../src/utils/usage-filters.ts",
    "../src/utils/session-select.ts",
    "../src/utils/session-sort.ts",
    "../src/utils/session-attribution.ts",
    "../src/utils/session-archived.ts",
    "../src/utils/agents-schema.ts",
    "../src/utils/terminal-schema.ts",
    "../src/utils/search-schema.ts",
    "../src/utils/branch-name.ts",
    "../src/utils/view-filters-query.ts",
    "../src/utils/query/index.ts",
    "../src/utils/query/registry.ts",
    "../src/utils/query/ast.ts",
    "../src/utils/query/evaluate.ts",
    "../src/utils/query/fields.ts",
    "../src/utils/query/lexer.ts",
    "../src/utils/query/parser.ts",
    "../src/lifecycle/types.ts"
  ]
}

{
  "name": "syntaur",
  "version": "0.79.0",
  "description": "Project workflow CLI with dashboard, Claude Code plugin, and Codex plugin",
  "homepage": "https://github.com/prong-horn/syntaur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prong-horn/syntaur.git"
  },
  "bugs": {
    "url": "https://github.com/prong-horn/syntaur/issues"
  },
  "keywords": [
    "agents",
    "cli",
    "codex",
    "claude",
    "workflow",
    "missions"
  ],
  "type": "module",
  "bin": {
    "syntaur": "./bin/syntaur.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/dashboard/server.js": "./dist/dashboard/server.js"
  },
  "files": [
    "dist",
    "bin",
    ".agents",
    "platforms",
    "skills",
    ".claude-plugin",
    "examples",
    "templates",
    "dashboard/dist",
    "statusline"
  ],
  "scripts": {
    "build": "tsup",
    "build:dashboard": "npm run build && npm run build --prefix dashboard",
    "dev": "tsup --watch",
    "dev:dashboard": "cd dashboard && npm run dev",
    "dashboard:install": "cd dashboard && npm install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mirror-skills": "node scripts/mirror-skills-to-platforms.mjs",
    "sync-plugin-version": "node scripts/sync-plugin-version.mjs",
    "build:skills-index": "node scripts/build-skills-index.mjs",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json platforms/claude-code/.claude-plugin/plugin.json platforms/codex/.codex-plugin/plugin.json",
    "prepack": "node scripts/mirror-skills-to-platforms.mjs && node scripts/sync-plugin-version.mjs",
    "prepublishOnly": "npm run build && npm ci --prefix dashboard && npm run build --prefix dashboard",
    "try": "node scripts/try.mjs",
    "untry": "npm unlink -g syntaur && npm install -g syntaur@latest && echo '\\n\u2713 global syntaur restored to latest published version'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@inquirer/prompts": "^8.4.2",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^4.0.0",
    "commander": "^13.0.0",
    "croner": "^10.0.1",
    "express": "^5.0.1",
    "fuse.js": "^7.1.0",
    "open": "^10.0.0",
    "ws": "^8.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.1",
    "vitest": "^3.0.0"
  }
}
